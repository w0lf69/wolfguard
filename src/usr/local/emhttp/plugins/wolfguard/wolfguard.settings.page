<script>
// Sync checkboxes to hidden inputs
function syncTiers() {
    var t1 = [];
    document.querySelectorAll('.tier1-cb:checked').forEach(function(cb) {
        t1.push(cb.value);
    });
    document.getElementById('vms-tier1').value = t1.join(',');

    var t2 = [];
    document.querySelectorAll('.tier2-cb:checked').forEach(function(cb) {
        t2.push(cb.value);
    });
    document.getElementById('vms-tier2').value = t2.join(',');
}

// Mutual exclusion: a VM can't be in both tiers
document.querySelectorAll('.tier1-cb').forEach(function(cb) {
    cb.addEventListener('change', function() {
        if (this.checked) {
            var t2 = document.querySelector('.tier2-cb[value="' + this.value + '"]');
            if (t2) t2.checked = false;
        }
        syncTiers();
    });
});
document.querySelectorAll('.tier2-cb').forEach(function(cb) {
    cb.addEventListener('change', function() {
        if (this.checked) {
            var t1 = document.querySelector('.tier1-cb[value="' + this.value + '"]');
            if (t1) t1.checked = false;
        }
        syncTiers();
    });
});

// Initial sync
syncTiers();
</script>
